# Copy to .env and change every "change-me":  cp .env.example .env
# Secret key:   openssl rand -base64 60 | tr -d '\n'
# DB password:  openssl rand -base64 32 | tr -d '/+='

AUTHENTIK_TAG=2026.8.3
AUTHENTIK_SECRET_KEY=change-me
AUTHENTIK_ERROR_REPORTING__ENABLED=false
AUTHENTIK_DISABLE_STARTUP_ANALYTICS=true

# Shared Postgres container (core/postgres)
AUTHENTIK_POSTGRESQL__HOST=lapcloud-postgres
AUTHENTIK_POSTGRESQL__PORT=5432
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=change-me

# Host ports
COMPOSE_PORT_HTTP=9000
COMPOSE_PORT_HTTPS=9443

TZ=UTC
