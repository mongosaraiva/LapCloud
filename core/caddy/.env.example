# Copy to .env:  cp .env.example .env

# Base name for all apps: auth.<domain>, photos.<domain>, ...
# "lapcloud.lan" needs a DNS entry or /etc/hosts line on each device
# (see docs/local-names.md). "localhost" works on this machine only.
LAPCLOUD_DOMAIN=lapcloud.lan

# Host port for HTTP
CADDY_HTTP_PORT=80
