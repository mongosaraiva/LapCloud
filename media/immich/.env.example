# Copy to .env and change the password:  cp .env.example .env
# Password: openssl rand -base64 48 | tr -dc 'A-Za-z0-9' | head -c 40
# (Immich accepts only letters and numbers in DB_PASSWORD)

IMMICH_VERSION=v3
TZ=UTC

# Where photos and videos are stored. Point this to a big disk if you have one,
# for example /mnt/photos
UPLOAD_LOCATION=./data/library
# Immich database (keep on SSD)
DB_DATA_LOCATION=./data/postgres

DB_PASSWORD=change-me
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
