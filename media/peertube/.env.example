# Copy to .env and change every "change-me":  cp .env.example .env
# Secret:       openssl rand -hex 32
# DB password:  openssl rand -base64 32 | tr -d '/+='

PEERTUBE_VERSION=production-bookworm
TZ=UTC

# Public name of this instance. Must match your Caddy name: videos.<LAPCLOUD_DOMAIN>
# Choose it BEFORE the first start. PeerTube stores it, and changing it later is hard.
PEERTUBE_WEBSERVER_HOSTNAME=videos.lapcloud.lan
PEERTUBE_WEBSERVER_PORT=80
PEERTUBE_WEBSERVER_HTTPS=false
# Trust the Caddy proxy (Docker networks)
PEERTUBE_TRUST_PROXY=["127.0.0.1", "loopback", "172.16.0.0/12"]

# Needs at least 32 characters
PEERTUBE_SECRET=change-me
PEERTUBE_ADMIN_EMAIL=admin@lapcloud.lan

# Shared Postgres container (core/postgres)
PEERTUBE_DB_HOSTNAME=lapcloud-postgres
PEERTUBE_DB_PORT=5432
PEERTUBE_DB_NAME=peertube
PEERTUBE_DB_USERNAME=peertube
PEERTUBE_DB_PASSWORD=change-me
PEERTUBE_DB_SSL=false

PEERTUBE_REDIS_HOSTNAME=redis
